&control
    calculation = 'scf'
    prefix      = 'mos2'
    outdir      = './out'
    pseudo_dir  = '../../pseudo'
/
&system
    ibrav       = 4
    celldm(1)   = 5.982378      ! a = 3.166 Angstrom, PBE+D3 cell from Phonon_Dispersion_D3/1-vc-relax
    celldm(3)   = 3.903990      ! c/a, c = 12.359 Angstrom
    nat         = 6
    ntyp        = 2
    ecutwfc     = 60
    occupations = 'fixed'
    nbnd        = 22            ! 18 occupied + 4 empty bands, to see the gap
/
&electrons
    conv_thr    = 1.0d-9
/
ATOMIC_SPECIES
S  32.06  S.pbe-mt_fhi.UPF
Mo 95.95  Mo.pbe-mt_fhi.UPF

ATOMIC_POSITIONS {crystal}
S  0.3333333333 0.6666666667 0.1224941157
S  0.6666666667 0.3333333333 0.6224941157
S  0.3333333333 0.6666666667 0.3775058843
S  0.6666666667 0.3333333333 0.8775058843
Mo 0.6666666667 0.3333333333 0.2500000000
Mo 0.3333333333 0.6666666667 0.7500000000

K_POINTS {automatic}
6 6 2 0 0 0                     ! contains Gamma and K = (1/3, 1/3, 0)
